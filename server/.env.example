# ---- Runtime ----
NODE_ENV=production
PORT=5000

# ---- Database ----
# Use a real MongoDB / Atlas URI in production.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/sovraxion_mnl
# When MONGODB_URI is empty, an embedded MongoDB with on-disk persistence is started.
USE_MEMORY_DB=false

# ---- Auth / sessions ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-64-plus-character-random-hex-string
JWT_EXPIRES_IN=7d
COOKIE_SAMESITE=strict
COOKIE_SECURE=true
# Only enable when the frontend runs inside a sandbox that blocks cookies (in-memory bearer token fallback).
ALLOW_BEARER_FALLBACK=false
ALLOW_NULL_ORIGIN=false

# ---- CORS ----
CLIENT_ORIGINS=https://sovraxionmnl.com,https://www.sovraxionmnl.com
TRUST_PROXY=1

# ---- Exclusive store owner (the ONLY admin) ----
OWNER_EMAIL=owner@sovraxionmnl.com
OWNER_PASSWORD=change-me-to-a-long-unique-passphrase
OWNER_USERNAME=sovraxion_owner
